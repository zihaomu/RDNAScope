{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RDNAScope compilation cache fingerprint v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "backend", "gfx", "python_abi", "framework", "compiler", "sdk", "native_sha256", "source_sha256", "codegen_sha256", "compile_flags"],
  "properties": {
    "schema_version": {"const": 1},
    "backend": {"enum": ["custom", "triton", "torchinductor"]},
    "gfx": {"$ref": "#/$defs/text"}, "python_abi": {"$ref": "#/$defs/text"},
    "framework": {"$ref": "#/$defs/version"}, "compiler": {"$ref": "#/$defs/version"},
    "sdk": {"type": "object", "additionalProperties": false, "required": ["name", "version", "digest"], "properties": {"name": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/sha"}}},
    "native_sha256": {"$ref": "#/$defs/sha"}, "source_sha256": {"$ref": "#/$defs/sha"}, "codegen_sha256": {"$ref": "#/$defs/sha"},
    "compile_flags": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "version": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}}}
  }
}
