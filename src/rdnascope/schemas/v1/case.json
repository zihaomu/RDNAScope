{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RDNAScope case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "basis",
    "status",
    "title",
    "records",
    "observation",
    "limits",
    "reopen_when"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "basis": {
      "enum": [
        "live",
        "historical_reanalysis",
        "synthetic",
        "declaration"
      ]
    },
    "status": {
      "enum": [
        "diagnostic",
        "hypothesis",
        "inconclusive",
        "rejected",
        "validated"
      ]
    },
    "title": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "record_sha256"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "record_sha256": {
            "type": "string"
          }
        }
      }
    },
    "observation": {
      "type": "string"
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reopen_when": {
      "type": "string"
    }
  }
}
