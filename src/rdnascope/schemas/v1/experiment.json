{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RDNAScope experiment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "basis",
    "candidate_type",
    "hypothesis",
    "baseline",
    "candidate",
    "stages",
    "decision",
    "adopted",
    "source_action",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "basis": {
      "enum": [
        "live",
        "historical_reanalysis",
        "synthetic",
        "declaration"
      ]
    },
    "candidate_type": {
      "enum": [
        "kernel_layout",
        "cache_transfer",
        "thread_config",
        "parallel_topology"
      ]
    },
    "hypothesis": {
      "type": "string"
    },
    "baseline": {
      "type": "object"
    },
    "candidate": {
      "type": "object"
    },
    "stages": {
      "type": "object"
    },
    "decision": {
      "enum": [
        "diagnostic",
        "hypothesis",
        "inconclusive",
        "rejected",
        "validated"
      ]
    },
    "adopted": {
      "const": false
    },
    "source_action": {
      "enum": [
        "preserved_isolated",
        "rejected_isolated",
        "not_run"
      ]
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
