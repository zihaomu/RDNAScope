{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RDNAScope benchmark-contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "basis",
    "kind",
    "metric",
    "match_keys",
    "protocol",
    "intentional_changes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "basis": {
      "enum": [
        "live",
        "historical_reanalysis",
        "synthetic",
        "declaration"
      ]
    },
    "kind": {
      "enum": [
        "model",
        "kernel",
        "communication",
        "cpu_fixture"
      ]
    },
    "metric": {
      "type": "object",
      "required": [
        "name",
        "unit",
        "direction"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "lower",
            "higher"
          ]
        }
      }
    },
    "match_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "boots",
        "warmups",
        "repeats",
        "max_aa_spread",
        "min_gain",
        "classification",
        "sequence"
      ],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "boots": {
          "type": "integer",
          "minimum": 3
        },
        "warmups": {
          "type": "integer",
          "minimum": 0
        },
        "repeats": {
          "type": "integer",
          "minimum": 1
        },
        "max_aa_spread": {
          "type": "number",
          "minimum": 0
        },
        "min_gain": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "classification": {
          "enum": [
            "screening",
            "formal"
          ]
        },
        "sequence": {
          "type": "array",
          "items": {
            "enum": [
              "A",
              "B"
            ]
          }
        }
      }
    },
    "intentional_changes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
