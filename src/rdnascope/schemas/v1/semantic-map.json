{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RDNAScope semantic sidecar v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "basis",
    "run_id",
    "provider",
    "input_artifacts",
    "entries",
    "dependencies",
    "clock",
    "scope_complete"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "basis": {
      "enum": [
        "live",
        "historical_reanalysis",
        "synthetic",
        "declaration"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "provider": {
      "type": "object"
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "clock": {
      "type": "object"
    },
    "scope_complete": {
      "type": "boolean"
    }
  }
}
