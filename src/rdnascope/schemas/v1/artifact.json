{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RDNAScope artifact v1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "sha256", "bytes", "format", "uri", "storage", "role"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bytes": {"type": "integer", "minimum": 0},
    "format": {"enum": ["rocpd", "pftrace", "http", "chrome", "legacy_manifest", "legacy_events"]},
    "uri": {"type": "string", "pattern": "^file://"},
    "storage": {"const": "external_read_only"},
    "role": {"enum": ["input", "legacy_manifest", "legacy_events"]}
  }
}
