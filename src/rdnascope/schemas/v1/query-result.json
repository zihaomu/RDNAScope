{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RDNAScope query result v1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "query_id", "view", "rows", "provenance", "quality", "page", "cache_hit"],
  "properties": {
    "schema_version": {"const": 1}, "run_id": {"type": "string"}, "query_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "view": {"enum": ["summary", "events", "kernels", "metrics", "phases", "collectives", "coverage", "provenance"]},
    "rows": {"type": "array", "items": {"type": "object"}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["inputs", "provider", "implementation", "identity_sha256"], "properties": {"inputs": {"type": "array", "items": {"type": "string"}}, "provider": {"type": "object"}, "implementation": {"type": "string"}, "identity_sha256": {"type": "string"}}},
    "quality": {"type": "object"},
    "page": {"type": "object", "additionalProperties": false, "required": ["limit", "offset", "returned", "has_more"], "properties": {"limit": {"type": "integer", "minimum": 1, "maximum": 1000}, "offset": {"type": "integer", "minimum": 0}, "returned": {"type": "integer", "minimum": 0}, "has_more": {"type": "boolean"}}},
    "cache_hit": {"type": "boolean"}
  }
}
