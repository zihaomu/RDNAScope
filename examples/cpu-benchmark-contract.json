{
  "schema_version": 1,
  "basis": "synthetic",
  "kind": "cpu_fixture",
  "metric": {"name": "fixture_duration_ns", "unit": "ns", "direction": "lower"},
  "match_keys": ["workload_revision", "runtime_digest", "source_digest", "device_set", "profiled", "cache_condition", "variant"],
  "intentional_changes": ["variant"],
  "protocol": {
    "cases": ["small", "large"],
    "boots": 3,
    "warmups": 1,
    "repeats": 3,
    "max_aa_spread": 0.05,
    "min_gain": 0.1,
    "classification": "formal",
    "sequence": ["A", "B", "B", "A", "A", "B"]
  }
}
